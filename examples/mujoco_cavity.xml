<mujoco model="hollow_tetra_probe">
  <!-- A 3x3x1 hexahedral grid, omitting the center cell. Each of the
       remaining eight boxes is divided into six conforming tetrahedra.
       The omitted center leaves a through-cavity x,y in [-0.4,0.4]. -->
  <option timestep="0.001" gravity="0 0 0" integrator="discrete" solver="Newton"/>
  <worldbody>
    <flexcomp name="cavity" type="direct" dim="3" mass="1"
              radius="0.005"
              point="
        -1 -1 -0.6 -0.4 -1 -0.6 0.4 -1 -0.6 1 -1 -0.6
        -1 -0.4 -0.6 -0.4 -0.4 -0.6 0.4 -0.4 -0.6 1 -0.4 -0.6
        -1 0.4 -0.6 -0.4 0.4 -0.6 0.4 0.4 -0.6 1 0.4 -0.6
        -1 1 -0.6 -0.4 1 -0.6 0.4 1 -0.6 1 1 -0.6
        -1 -1 0.6 -0.4 -1 0.6 0.4 -1 0.6 1 -1 0.6
        -1 -0.4 0.6 -0.4 -0.4 0.6 0.4 -0.4 0.6 1 -0.4 0.6
        -1 0.4 0.6 -0.4 0.4 0.6 0.4 0.4 0.6 1 0.4 0.6
        -1 1 0.6 -0.4 1 0.6 0.4 1 0.6 1 1 0.6
              "
              element="
        0 1 5 21 0 5 4 21 0 4 20 21 0 20 16 21 0 16 17 21 0 17 1 21
        1 2 6 22 1 6 5 22 1 5 21 22 1 21 17 22 1 17 18 22 1 18 2 22
        2 3 7 23 2 7 6 23 2 6 22 23 2 22 18 23 2 18 19 23 2 19 3 23
        4 5 9 25 4 9 8 25 4 8 24 25 4 24 20 25 4 20 21 25 4 21 5 25
        6 7 11 27 6 11 10 27 6 10 26 27 6 26 22 27 6 22 23 27 6 23 7 27
        8 9 13 29 8 13 12 29 8 12 28 29 8 28 24 29 8 24 25 29 8 25 9 29
        9 10 14 30 9 14 13 30 9 13 29 30 9 29 25 30 9 25 26 30 9 26 10 30
        10 11 15 31 10 15 14 31 10 14 30 31 10 30 26 31 10 26 27 31 10 27 11 31
              ">
      <contact selfcollide="none" activelayers="1" condim="3"/>
      <elasticity poisson="0.3" young="5000" damping="0.005"/>
    </flexcomp>
    <!-- A second, independent tetrahedral flex intersects the inner wall near
         the top of the channel, away from the rigid probe. -->
    <flexcomp name="inner" type="direct" dim="3" mass="0.05" radius="0.005"
              point="0.30 -0.05 0.40  0.44 -0.05 0.40
                     0.30 0.09 0.40   0.30 -0.05 0.54"
              element="0 1 2 3">
      <contact selfcollide="none" condim="3"/>
      <elasticity poisson="0.3" young="5000" damping="0.005"/>
    </flexcomp>
    <body name="probe" pos="0.10 0 0">
      <freejoint/>
      <geom name="probe_geom" type="sphere" size="0.34" mass="0.15"
            friction="0.6 0.005 0.0001"/>
    </body>
  </worldbody>
</mujoco>
